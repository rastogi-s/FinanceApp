# Copy to .env next to docker-compose.yml and fill in. Keep it private: chmod 600 .env

# Database password. Generate one:  openssl rand -hex 32   (hex, because it goes into a database URL)
POSTGRES_PASSWORD=

# The names you open the app at. Add your Tailscale name, e.g. finance.tail1234.ts.net
ALLOWED_HOSTS=localhost,127.0.0.1

# "true" once the app is only reached over HTTPS (tailscale serve gives you HTTPS)
HSTS=false

# Backups (made by update.sh before every update). The PUBLIC key from:  age-keygen -o finance-backup.key
# Keep finance-backup.key (the private key) OFF this server, e.g. in your password manager: a stolen server
# then can't read its own backups. You only need the private key to restore.
BACKUP_AGE_RECIPIENT=

# The master key that encrypts bank tokens and code-app secrets in the database (AES-256-GCM). update.sh makes
# one the first time it runs. COPY IT TO YOUR PASSWORD MANAGER: it is deliberately not in the backups, so a stolen
# backup is useless on its own, and a restore without it means linking accounts and the code app again.
# To make one by hand:  openssl rand -base64 32
ENCRYPTION_KEY=

# --- Linking accounts (all read-only). Leave a provider empty to hide it; file uploads always work. ---

# Plaid, for banks and cards: https://dashboard.plaid.com/developers/keys
# PLAID_ENV is "sandbox" to try it with fake banks, "production" for real ones (the free Trial plan is production).
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# SnapTrade, for brokerages (E*TRADE, Fidelity, Schwab, Robinhood...): https://dashboard.snaptrade.com
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=

# How often accounts sync, in hours
SYNC_INTERVAL_HOURS=4

# --- Security alerts: new-device sign-ins, lockouts, a connection that stopped syncing. Never amounts. ---

# ntfy (https://ntfy.sh): pick a long random topic, e.g. https://ntfy.sh/finance-$(openssl rand -hex 12),
# and subscribe to it in the ntfy phone app. NTFY_TOKEN only if your ntfy server needs one.
NTFY_URL=
NTFY_TOKEN=

# Email, used when ntfy isn't set or doesn't answer
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL=

# The version update.sh installed. Leave it alone; update.sh writes it.
FINANCEAPP_VERSION=latest

# Your time zone, e.g. America/Los_Angeles (used for the nightly sync and the morning brief)
TZ=UTC

# Sample data instead of your accounts, for trying the app out
DEMO_MODE=false
