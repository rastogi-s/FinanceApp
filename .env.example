# Copy to .env next to docker-compose.yml and fill in. Keep it private: chmod 600 .env

# Database password. Generate one:  openssl rand -base64 32
POSTGRES_PASSWORD=

# The names you open the app at. Add your Tailscale name, e.g. finance.tail1234.ts.net
ALLOWED_HOSTS=localhost,127.0.0.1

# "true" once the app is only reached over HTTPS (tailscale serve gives you HTTPS)
HSTS=false

# Backups (made by update.sh before every update). The PUBLIC key from:  age-keygen -o finance-backup.key
# Keep finance-backup.key (the private key) OFF this server, e.g. in your password manager: a stolen server
# then can't read its own backups. You only need the private key to restore.
BACKUP_AGE_RECIPIENT=

# The version update.sh installed. Leave it alone; update.sh writes it.
FINANCEAPP_VERSION=latest

# Your time zone, e.g. America/Los_Angeles (used for the nightly sync and the morning brief)
TZ=UTC

# Sample data instead of your accounts, for trying the app out
DEMO_MODE=false
