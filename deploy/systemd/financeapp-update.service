# Runs update.sh once. Started by the nightly timer and by "Update now" in the app (financeapp-update.path).
# update.sh installs it for the folder it's in when run as root; WorkingDirectory is the folder with
# docker-compose.yml, .env and update.sh.
[Unit]
Description=Update the Finance App
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/financeapp
ExecStart=/opt/financeapp/update.sh
# Failures show in: journalctl -u financeapp-update
